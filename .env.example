# FlagOps — Environment Variables
# Copy this file to .env and fill in actual values
# NEVER commit .env to Git

# ── Database ──────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:flagops@localhost:5432/flagops

# ── Redis ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Auth / JWT ────────────────────────────────────
SECRET_KEY=change-me-to-a-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Config Secret Encryption ─────────────────────
# Must be exactly 32 bytes for AES-256-GCM
CONFIG_MASTER_KEY=change-me-32-bytes-key-here!!!!

# ── Server ────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=true
LOG_LEVEL=INFO

# ── CORS ──────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
